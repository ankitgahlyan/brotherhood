# _headers — Cloudflare Pages header rules for the Web (PWA) deployment.
# Docs: https://developers.cloudflare.com/pages/configuration/headers/
#
# Applied to all routes (/brotherhood/*):
#   - Standard security headers for standalone PWA
#   - Allows framing from 'self' only (no Telegram embedding on web variant)

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https: wss:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'

/*.webmanifest
  Content-Type: application/manifest+json; charset=utf-8

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/workbox-*.js
  Cache-Control: no-cache, no-store, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable
