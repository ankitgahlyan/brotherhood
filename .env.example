# Base path. The app publishes to a GitHub Pages *project* site by default
# (https://ankitgahlyan.github.io/brotherhood/) => VITE_BASE=/brotherhood/.
# Override to '/' for a user/org Pages site or Cloudflare Pages.
# Must stay in sync with src/router.tsx (basepath) and vite.config.ts (base).
VITE_BASE=/brotherhood/

# Toncenter API keys (optional; exposed to the browser as VITE/TONCENTER_*).
# Without them the dashboard still works but hits rate limits sooner.
TONCENTER_MAINNET_API_KEY=
TONCENTER_TESTNET_API_KEY=

# OpenRouter (server-only). Used by the /api/chat route (@tanstack/ai-openai).
# For local dev: copy to .dev.vars (Cloudflare dev) or export in your shell.
# On Cloudflare Workers pass as a secret/var binding. Never put in .env that
# ships to the client.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat
