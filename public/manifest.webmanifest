{
  "name": "TanStack Mobile PWA",
  "short_name": "TanStack PWA",
  "description": "Offline-first, mobile-friendly demo app built with TanStack Start.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#e7f3ec",
  "theme_color": "#173a40",
  "lang": "en",
  "scope": "/",
  "orientation": "portrait",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    {
      "src": "/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    { "src": "/apple-touch-icon.png", "sizes": "180x180", "type": "image/png" }
  ]
}
