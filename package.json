{
  "name": "brotherhood",
  "private": true,
  "version": "0.1.0",
  "homepage": "https://ankitgahlyan.github.io/brotherhood",
  "packageManager": "bun@1.3.14",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/wallet dev",
    "generate-routes": "bun run --cwd apps/wallet generate-routes",
    "build": "bun run build:packages && bun run --cwd apps/wallet build",
    "build:packages": "bun run --cwd packages/walletkit build && bun run --cwd packages/v4ledger-adapter build && bun run --cwd packages/wallet-core build",
    "build:static": "bun run build",
    "build:ghpages": "bun run build && node scripts/gh-pages-404.mjs",
    "build:all": "acton build && bun run build",
    "preview": "bun run --cwd apps/wallet preview",
    "lint": "eslint --max-warnings 0 .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write . && eslint --fix .",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "check": "prettier --check .",
    "typecheck": "bun run --cwd packages/walletkit typecheck && bun run --cwd packages/v4ledger-adapter typecheck && bun run --cwd packages/wallet-core typecheck && bun run --cwd apps/wallet typecheck",
    "test": "acton test",
    "test:affected": "node scripts/pre-commit-tests.mjs",
    "test:changed": "node scripts/pre-commit-tests.mjs",
    "test:e2e": "bun run --cwd apps/wallet e2e",
    "icons": "node scripts/generate-icons.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "smoke:build": "node scripts/gh-pages-404.mjs && node scripts/smoke-test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@ton/core": "^0.63.1",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^16.3.0",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.0",
    "allure-js-commons": "^3.11.0",
    "allure-playwright": "^3.11.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "5.8.2",
    "typescript-eslint": "^8.69.0"
  },
  "overrides": {
    "typescript": "5.8.2"
  }
}
