  "version": "0.1.0",
  "homepage": "https://ankitgahlyan.github.io/brotherhood",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "build:static": "vite build",
    "build:ghpages": "vite build && node scripts/gh-pages-404.mjs",
