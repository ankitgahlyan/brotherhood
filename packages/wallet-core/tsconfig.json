{
  "compilerOptions": {
    "target": "ES2024",
    "outDir": "dist/cjs",
    "module": "es2022",
    "moduleResolution": "bundler",
    "declaration": true,
    "declarationDir": "dist/cjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "removeComments": false,
    "declarationMap": true,
    "jsx": "react-jsx"
  },
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.fixture.ts",
    "**/*.config.ts",
    "**/__tests__/**",
    "node_modules",
    "coverage",
    ".stryker-tmp",
    "dist"
  ],
  "include": ["src/**/*"]
}
